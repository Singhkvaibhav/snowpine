PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snowpine
# Used only when NODE_ENV=test (npm test) - a separate real database, not
# mocks, so tests catch concurrency/constraint bugs mocks would hide.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/snowpine_test

# How long an unpaid order holds its stock reservation before an
# in-process sweep (every 5 min, see server.js) releases it back to
# inventory. Keep generous enough for a customer to actually complete
# payment, short enough that abandoned carts don't lock up stock for long.
RESERVATION_TTL_MINUTES=30

# How long a "pending" (unpaid) order sits before the same sweep emails a
# one-time abandoned-cart reminder with a link to resume payment on the
# SAME order - see ordersService.sendAbandonedCartReminders. Keep this
# comfortably below RESERVATION_TTL_MINUTES so there's real time left to
# act on the email before the reservation above releases the stock.
ABANDONED_CART_EMAIL_DELAY_MINUTES=15

# How long a customer's login session lasts (customer_sessions table -
# see routes/auth.js). Logging out deletes the session row directly, so
# this length just controls how long an inactive session stays valid.
SESSION_TTL_DAYS=30

# Payments - Razorpay is wired up (checkout collects real payment when
# these are set). Sign up at razorpay.com and use your test-mode keys
# here to test the full payment flow; leave unset for local dev without
# payment collection (checkout falls back to an unpaid "pending" order).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-authoritative payment confirmation (see backend/routes: POST
# /api/webhooks/razorpay). Set this to the webhook secret you configure
# in the Razorpay dashboard when adding the webhook URL. Leave unset to
# rely on client-side signature verification only (still secure, just
# less robust against a browser closing mid-checkout).
RAZORPAY_WEBHOOK_SECRET=

# Minimal shared-secret admin access (GET/PATCH /api/admin/orders). Set
# to a long random string - there is no per-user login, this is the only
# gate on the admin API, so treat it like a password. Leave unset to
# disable admin routes entirely (fails closed).
ADMIN_TOKEN=

# Order confirmation email. Leave unset to log emails to the console
# instead of sending (fine for dev). Set all four to send real email via
# SMTP (Gmail, SES, Postmark, Resend, etc. all work over SMTP).
# Resend (recommended - free tier, easy setup): host smtp.resend.com,
# port 465, user "resend", pass = your Resend API key (re_...).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Without a verified custom domain, Resend's shared onboarding@resend.dev
# sender only delivers to the email the Resend account was signed up
# with - fine for testing, swap in a verified domain's address to email
# real customers. email.js already defaults to onboarding@resend.dev if
# this is left unset.
SMTP_FROM=

# Where low-stock alerts go (see productsService.js's
# maybeSendLowStockAlert). Leave unset to disable alerts entirely - they
# won't block anything either way, but you won't be notified.
ADMIN_EMAIL=
