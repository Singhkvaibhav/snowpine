PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snowpine

# Payments - not wired up yet. India-facing checkout needs a provider that
# supports domestic INR settlement for an India-registered seller (Stripe is
# export-only under RBI rules unless specially approved). Razorpay/Cashfree/
# PayU are the standard choice here - add credentials once checkout is built.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
