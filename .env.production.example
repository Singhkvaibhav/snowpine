# Copy to .env.production and fill in real values. Never commit the real
# file - it's gitignored. docker-compose reads POSTGRES_PASSWORD directly
# from the shell/compose environment (not from this file) for the
# postgres/api DATABASE_URL interpolation - export it or put it in a
# top-level .env that `docker compose` auto-loads; everything else here
# is passed straight through to the api container via env_file.

POSTGRES_PASSWORD=

CORS_ORIGINS=https://your-domain.example
FRONTEND_URL=https://your-domain.example
RESERVATION_TTL_MINUTES=30

# How long a customer's login session lasts before they need to log in
# again. Logging out revokes the session immediately regardless of this.
SESSION_TTL_DAYS=30

# Razorpay - required for real payment collection. Live keys, not test
# keys, once you're actually launching (rzp_live_... / a live secret).
# The API REFUSES TO START in production without KEY_ID/KEY_SECRET set
# (see backend/configCheck.js) - booting "successfully" while silently
# never collecting payment is worse than not booting at all.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Long random string - the only gate on /admin and /api/admin/*.
ADMIN_TOKEN=

# Order confirmation email over SMTP. Leave unset and orders still work -
# confirmations just log to the container's stdout instead of sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@your-domain.example
